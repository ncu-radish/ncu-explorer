# ========================================================
# NCU Explorer Backend Environment Configuration
# ========================================================

# ====== 基礎 API 服務設定 ======
PROJECT_NAME="NCU Life Simulator & Explorer API"
VERSION="1.0.0"
API_V1_STR="/api"

# ====== 跨來源資源共享 (CORS) ======
# 多個網址請以逗點分隔 (例如: http://localhost:3000,https://ncu.your-domain.edu.tw)
# 若在本地端開發可填入 * 或前端開發伺服器位址
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ====== 資料庫連線 (SQLAlchemy Database URL) ======
# 本地預設使用 SQLite，部屬到生產資料庫可改為 PostgreSQL 或 MySQL：
# 範例: postgresql://username:password@localhost:5432/ncu_sim
DATABASE_URL="sqlite:///./data/ncu_sim.sqlite"

# ====== Qdrant 向量資料庫 ======
# 若 QDRANT_URL 為空字串，系統將自動回退使用本地磁碟路徑 (./data/qdrant_storage)
# 伺服器 Docker 部署範例: http://qdrant:6333 或 http://localhost:6333
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="ncu_courses_hybrid"

# ====== 本地 / 伺服器 LLM (Ollama) ======
# 指向 Ollama 服務端點 (伺服器容器部署時可改為例如 http://ollama:11434)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="gemma3:4b"
EVENT_TRIGGER_PROB=0.35

# ====== JWT 身份驗證與密鑰安全性 ======
# 【重要】生產環境務必使用隨機生成的高強度金鑰 (例如執行: openssl rand -hex 32)
SECRET_KEY="change-me-to-a-super-secret-random-token-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====== 初始管理員設定 (由 seed_db.py 讀取) ======
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="adminpassword123"
