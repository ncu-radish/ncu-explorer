# ========================================================
# NCU Explorer Frontend Environment Configuration
# ========================================================

# ====== 後端 API 根端點 (Client-side 需使用 NEXT_PUBLIC_ 前綴) ======
# 本地開發預設: http://localhost:8000/api
# 生產環境部屬 (獨立 API 網域): https://api.yourdomain.com/api
# 生產環境部屬 (同網域 Nginx 反向代理): /api
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# ====== 3D 校園地圖模型資源路徑 ======
# 本地預設存放於 public/models/ncu_campus.glb
# 若將 3D 模型存放於物件儲存 (如 AWS S3, Cloudflare R2 或 CDN) 可填寫完整 URL
# 範例: https://cdn.yourdomain.com/models/ncu_campus.glb
NEXT_PUBLIC_CAMPUS_MODEL_URL="/models/ncu_campus.glb"
